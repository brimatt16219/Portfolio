---
import { site } from "../data/site";
const path = Astro.url.pathname;
const nav = [
  { href: "/work", label: "Work" },
  { href: "/lab", label: "Lab" },
  { href: "/about", label: "About" },
  { href: "/resume", label: "Resume" },
];
const isActive = (href: string) => path === href || path.startsWith(href + "/");
---

<header class="wrap site-header">
  <a href="/" class="brand" aria-label={`${site.name}, home`}>
    <span class="dot" aria-hidden="true"></span>{site.name}
  </a>
  <nav aria-label="Main">
    <ul>
      {
        nav.map((n) => (
          <li>
            <a href={n.href} aria-current={isActive(n.href) ? "page" : undefined}>
              {n.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="tools">
    <button type="button" class="kbd-btn" data-open-menu aria-label="Open command menu" aria-keyshortcuts="Control+K Meta+K">
      <kbd data-mod>Ctrl</kbd><kbd>K</kbd>
    </button>
    <button type="button" class="icon-btn" data-theme-toggle aria-label="Toggle dark theme">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor"></path>
      </svg>
    </button>
  </div>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 560;
    letter-spacing: -0.01em;
    text-decoration: none;
    margin-right: auto;
  }
  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--accent);
    view-transition-name: brand-dot;
  }
  ul {
    display: flex;
    gap: 1.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.9375rem;
  }
  nav a {
    display: inline-block;
    padding-block: 0.35rem;
    text-decoration: none;
    color: var(--muted);
  }
  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--ink);
  }
  nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
  }
  .tools {
    display: flex;
    gap: 0.4rem;
  }
  .icon-btn,
  .kbd-btn {
    display: inline-grid;
    place-items: center;
    min-width: 2.25rem;
    height: 2.25rem;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .kbd-btn {
    display: inline-flex;
    gap: 0.2rem;
    padding-inline: 0.5rem;
  }
  .icon-btn:hover,
  .kbd-btn:hover {
    color: var(--ink);
    border-color: var(--line);
  }
  kbd {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.05rem 0.3rem;
    border: 1px solid var(--line-strong);
    border-radius: 3px;
  }
  @media (max-width: 40rem) {
    .site-header {
      flex-wrap: wrap;
      row-gap: 0.5rem;
    }
    nav {
      order: 3;
      width: 100%;
    }
    .kbd-btn {
      display: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    localStorage.setItem("theme", next);
  });
  if (/Mac|iPhone|iPad/.test(navigator.platform)) {
    document.querySelectorAll("[data-mod]").forEach((el) => (el.textContent = "⌘"));
  }
</script>
