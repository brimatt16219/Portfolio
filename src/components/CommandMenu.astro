---
// Cmd/Ctrl+K menu: a native <dialog>, a filter box and a listbox.
// Optional for everyone; every item is also reachable from normal links.
import { getCollection } from "astro:content";
import { site } from "../data/site";

const work = (await getCollection("work"))
  .filter((w) => w.data.caseStudy)
  .sort((a, b) => a.data.order - b.data.order);

type Item = { label: string; group: string; href?: string; action?: string; hint?: string };
const items: Item[] = [
  { group: "Go to", label: "Home", href: "/" },
  { group: "Go to", label: "Work", href: "/work" },
  ...work.map((w) => ({ group: "Go to", label: w.data.title, href: `/work/${w.id}`, hint: "Case study" })),
  { group: "Go to", label: "Lab", href: "/lab" },
  { group: "Go to", label: "About", href: "/about" },
  { group: "Go to", label: "Resume", href: "/resume" },
  { group: "Go to", label: "Colophon", href: "/colophon" },
  { group: "Do", label: "Copy email address", action: "copy-email", hint: site.email },
  { group: "Do", label: "Toggle dark theme", action: "theme" },
  { group: "Do", label: "Download resume (PDF)", href: site.resumePdf },
  { group: "Elsewhere", label: "GitHub", href: site.links.github },
  { group: "Elsewhere", label: "LinkedIn", href: site.links.linkedin },
];
---

<dialog class="cmdk" aria-label="Command menu" data-cmdk data-email={site.email}>
  <div class="cmdk__box">
    <input
      type="text"
      placeholder="Type a page or action…"
      aria-label="Filter commands"
      role="combobox"
      aria-expanded="true"
      aria-controls="cmdk-list"
      autocomplete="off"
      spellcheck="false"
      data-q
    />
    <ul id="cmdk-list" role="listbox" data-list>
      {
        items.map((it, i) => (
          <li
            role="option"
            id={`cmdk-${i}`}
            data-label={it.label.toLowerCase()}
            data-href={it.href}
            data-action={it.action}
            data-group={it.group}
          >
            <span class="g">{it.group}</span>
            <span class="l">{it.label}</span>
            {it.hint && <span class="h">{it.hint}</span>}
          </li>
        ))
      }
    </ul>
    <p class="empty" data-empty hidden>Nothing matches.</p>
    <p class="foot mono"><kbd>↑</kbd><kbd>↓</kbd> move <kbd>↵</kbd> open <kbd>esc</kbd> close</p>
  </div>
</dialog>

<style>
  .cmdk {
    width: min(100% - 2rem, 34rem);
    margin: 14vh auto auto;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 24px 60px -20px rgb(0 0 0 / 0.35);
  }
  .cmdk::backdrop {
    background: rgb(20 18 15 / 0.35);
    backdrop-filter: blur(2px);
  }
  .cmdk[open] {
    animation: in 0.16s ease-out;
  }
  @keyframes in {
    from { opacity: 0; transform: translateY(-6px) scale(0.985); }
  }
  input {
    width: 100%;
    padding: 1rem 1.1rem;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 1rem;
  }
  input:focus {
    outline: none;
  }
  ul {
    max-height: 22rem;
    overflow: auto;
    list-style: none;
    margin: 0;
    padding: 0.4rem;
  }
  li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.6rem 0.7rem;
    border-radius: 6px;
    cursor: pointer;
  }
  li[aria-selected="true"] {
    background: var(--paper);
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .g {
    width: 4.5rem;
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--faint);
  }
  .h {
    margin-left: auto;
    font-size: 0.8125rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .empty,
  .foot {
    padding: 0.7rem 1.1rem;
    color: var(--muted);
  }
  .foot {
    display: flex;
    gap: 0.35rem;
    align-items: center;
    border-top: 1px solid var(--line);
    font-size: 0.6875rem;
  }
  kbd {
    font-family: inherit;
    padding: 0 0.3rem;
    border: 1px solid var(--line-strong);
    border-radius: 3px;
  }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>("[data-cmdk]")!;
  const q = dlg.querySelector<HTMLInputElement>("[data-q]")!;
  const opts = [...dlg.querySelectorAll<HTMLLIElement>("[role=option]")];
  const empty = dlg.querySelector<HTMLElement>("[data-empty]")!;
  let sel = 0;

  const visible = () => opts.filter((o) => !o.hidden);

  function select(i: number) {
    const v = visible();
    if (!v.length) return;
    sel = (i + v.length) % v.length;
    v.forEach((o, k) => o.setAttribute("aria-selected", String(k === sel)));
    q.setAttribute("aria-activedescendant", v[sel].id);
    v[sel].scrollIntoView({ block: "nearest" });
  }

  function filter() {
    const term = q.value.trim().toLowerCase();
    opts.forEach((o) => (o.hidden = !!term && !o.dataset.label!.includes(term)));
    empty.hidden = visible().length > 0;
    select(0);
  }

  function open() {
    q.value = "";
    filter();
    dlg.showModal();
    q.focus();
  }

  async function run(o: HTMLLIElement) {
    const { href, action } = o.dataset;
    if (action === "copy-email") {
      await navigator.clipboard?.writeText(dlg.dataset.email!).catch(() => {});
      o.querySelector(".l")!.textContent = "Copied ✓";
      setTimeout(() => dlg.close(), 500);
      setTimeout(() => (o.querySelector(".l")!.textContent = "Copy email address"), 700);
      return;
    }
    if (action === "theme") {
      document.querySelector<HTMLButtonElement>("[data-theme-toggle]")?.click();
      return;
    }
    dlg.close();
    if (href) location.href = href;
  }

  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      dlg.open ? dlg.close() : open();
    }
  });
  document.querySelectorAll("[data-open-menu]").forEach((b) => b.addEventListener("click", open));

  q.addEventListener("input", filter);
  q.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") (e.preventDefault(), select(sel + 1));
    else if (e.key === "ArrowUp") (e.preventDefault(), select(sel - 1));
    else if (e.key === "Enter") {
      e.preventDefault();
      const o = visible()[sel];
      if (o) run(o);
    }
  });
  opts.forEach((o) => {
    o.addEventListener("click", () => run(o));
    o.addEventListener("pointermove", () => select(visible().indexOf(o)));
  });
  dlg.addEventListener("click", (e) => e.target === dlg && dlg.close());
</script>
