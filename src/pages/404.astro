---
import Base from "../layouts/Base.astro";
---

<Base title="Not found">
  <section class="wrap nf">
    <p class="label">404</p>
    <h1 class="display">No route found.</h1>
    <p class="measure">Even 2-opt can't get you here. Try <a href="/">home</a> or <a href="/work">work</a>, or press <kbd>Ctrl</kbd> <kbd>K</kbd>.</p>
  </section>
</Base>

<style>
  .nf {
    padding-block: clamp(3rem, 14vh, 9rem) 2rem;
  }
  .nf h1 {
    margin-top: 1.25rem;
  }
  .nf p.measure {
    margin-top: 1.5rem;
    color: var(--muted);
  }
  kbd {
    font-family: var(--font-mono);
    font-size: 0.8em;
    padding: 0 0.3rem;
    border: 1px solid var(--line-strong);
    border-radius: 3px;
  }
</style>
